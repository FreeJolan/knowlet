# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenv
.venv/
venv/
env/

# uv
.uv/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code — ignore agent runtime / per-user-local state, but
# allow project-shared settings (.claude/settings.json) and
# slash commands (.claude/commands/) to be committed if added.
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Local scratch
scratch/
.scratch/

# In case someone runs knowlet from the repo root, don't commit vault state.
.knowlet/
/cards/
/notes/
/users/

# Models cache (if accidentally created in repo)
models/
.cache/

# Dogfood reports may include private impressions / frustrations the
# user doesn't want in a public history. Kept on disk for the user's
# reference; not tracked.
docs/dogfood/

# OAuth client_secret JSONs and any other credentials. Per Google's
# docs Desktop OAuth secrets aren't truly confidential, but committing
# them to a public repo trips GitHub's secret scanner and may trigger
# auto-rotation by Google. The .secrets/ dir is the canonical place
# to stash a downloaded client_secret*.json so we can find it again
# (sync.client_secrets_path in config.toml points here). Distribution
# strategy decision deferred — see the conversation around #113.
.secrets/
client_secret*.json
*credentials*.json
sync_credentials.json
google_drive_credentials.json
